{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abogadosrematesjudiciales",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "abogadosrematesjudiciales.cl", "custom_domain": true },
    { "pattern": "www.abogadosrematesjudiciales.cl", "custom_domain": true }
  ],
  "d1_databases": [
    // Base compartida por los sitios del grupo: el «buzón único».
    // Crear con: npx wrangler d1 create buzon-contactos  y copiar aquí su database_id.
    { "binding": "DB", "database_name": "buzon-contactos", "database_id": "PENDIENTE" }
  ],
  "vars": {
    "SITE_NAME": "Abogados Remates Judiciales",
    "NOTIFY_TO": "",
    "NOTIFY_FROM": ""
  },
  "observability": { "enabled": true }
}
